# Director-X Backend Configuration
# Copy this to .env and fill in your keys

# Server
PORT=3000

# Optional: Default API keys (can also be passed per-request from the frontend)
# FAL_API_KEY=
# ELEVENLABS_API_KEY=
# REPLICATE_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# MUAPI_KEY=          # muapi.ai key for Gemini Omni (text-to-video, image-to-video, video edit, characters)

# Free Video Generation (no API key needed!)
# COLAB_SERVER_URL=   # ngrok URL from the DirectorX Colab notebook (e.g. https://abc123.ngrok-free.app)

# Substack (for SEO backlinks)
# SUBSTACK_URL=https://riseandclaim.substack.com
